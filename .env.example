# Orthodox News Aggregator
# Copy this file to .env and fill in your values

# PostgreSQL connection string (Neon, Supabase, Render, or your own server)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Set to "false" only for local Postgres without SSL
# DATABASE_SSL=false

# Proxy URL for blocked sources (e.g., R16, R20, UA3)
# Format: http://user:password@proxy.example.com:8080
RSS_PROXY_URL=

# Admin server
ADMIN_PORT=3001
ADMIN_PASSWORD=

# Parser schedule (cron expression, default: every hour)
PARSER_CRON_SCHEDULE=0 * * * *

# Backup retention in days
BACKUP_RETENTION_DAYS=14
