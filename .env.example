# Orthodox News Aggregator
# Copy this file to .env and fill in your values

# Proxy URL for blocked sources (e.g., R16, R20, UA3)
# Format: http://user:password@proxy.example.com:8080
RSS_PROXY_URL=

# Telegram Bot API (для отправки новостей из админки в канал)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Admin panel
ADMIN_PORT=3001
ADMIN_PASSWORD=
